# Application Environment
APP_NAME=Docu-RAG
APP_ENV=development
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database (Neon)
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=docu_rag
DB_USERNAME=docu_rag
DB_PASSWORD=secret

# Redis (for caching, queues, etc.)
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Google Gemini API (for RAG)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# CORS (comma-separated frontend origins allowed to call the API)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Other settings
LOG_CHANNEL=stack
LOG_LEVEL=debug